{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lazyos.local/contracts/v1/intent.schema.json",
  "title": "Intent",
  "type": "object",
  "required": ["id", "ts", "task_id", "requester", "capability", "params", "provenance"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "requester": {
      "type": "string",
      "enum": ["voice", "text", "hud", "routine"]
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$"
    },
    "params": {
      "type": "object"
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "trusted"],
        "properties": {
          "source": { "type": "string" },
          "trusted": { "type": "boolean" },
          "detail": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": false
}
