{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lazyos.local/contracts/v1/event.schema.json",
  "title": "Event",
  "type": "object",
  "required": ["id", "ts", "type", "severity", "source", "data"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "type": "string",
      "enum": ["debug", "info", "warning", "error", "critical"]
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
