# Lazy OS Buildroot Target Defconfig (x86_64 UEFI)
# Specification: docs/BUILD_PROMPT_V3.md (K1, K2)

BR2_x86_64=y
BR2_x86_corei7=y

# Compiler Cache (Rule K11)
BR2_CCACHE=y
BR2_CCACHE_DIR="/var/cache/buildroot/ccache"

# Toolchain (Buildroot internal gcc or Bootlin external)
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_PACKAGE_HOST_GDB=y
BR2_PACKAGE_HOST_GDB_PYTHON=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_ENABLE_LOCALE_UTF8=y

# Init System (Systemd)
BR2_INIT_SYSTEMD=y
BR2_PACKAGE_SYSTEMD_JOURNAL_GATEWAYD=y
BR2_PACKAGE_SYSTEMD_NETWORKD=y
BR2_PACKAGE_SYSTEMD_RESOLVED=y
BR2_PACKAGE_SYSTEMD_TIMESYNCD=y
BR2_TARGET_GENERIC_HOSTNAME="lazy-os"
BR2_TARGET_GENERIC_ISSUE="Welcome to Lazy OS v3 Command Center"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_LAZY_OS_PATH)/board/lazy/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_LAZY_OS_PATH)/board/lazy/post-image.sh"

# Linux Kernel
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.6.21"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_LAZY_OS_PATH)/board/lazy/linux/linux.config"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_LAZY_OS_PATH)/board/lazy/linux/fragments/base-minimal.cfg $(BR2_EXTERNAL_LAZY_OS_PATH)/board/lazy/linux/fragments/fs.cfg $(BR2_EXTERNAL_LAZY_OS_PATH)/board/lazy/linux/fragments/memory.cfg $(BR2_EXTERNAL_LAZY_OS_PATH)/board/lazy/linux/fragments/security.cfg $(BR2_EXTERNAL_LAZY_OS_PATH)/board/lazy/linux/fragments/laptop.cfg"
BR2_LINUX_KERNEL_BZIMAGE=y
BR2_LINUX_KERNEL_INSTALL_TARGET=y

# Core Utilities & Filesystems
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_BTRFS_PROGS=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_LIBBLKID=y
BR2_PACKAGE_UTIL_LINUX_LIBMOUNT=y
BR2_PACKAGE_UTIL_LINUX_LSBLK=y
BR2_PACKAGE_UTIL_LINUX_FINDMNT=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_WIRELESS_REGDB=y

# Python Runtime & Dependencies
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON3_SSL=y
BR2_PACKAGE_PYTHON3_BZIP2=y
BR2_PACKAGE_PYTHON3_XZ=y
BR2_PACKAGE_PYTHON3_PYEXPAT=y
BR2_PACKAGE_PYTHON_PYYAML=y

# Lazy OS Custom Package
BR2_PACKAGE_LAZY_OS=y

# Target Filesystem Images
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS_ZSTD=y
BR2_TARGET_ROOTFS_TAR=y

# Host Build Tools
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y
BR2_PACKAGE_HOST_E2FSPROGS=y
BR2_PACKAGE_HOST_SQUASHFS=y
