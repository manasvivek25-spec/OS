[Unit]
Description=Lazy OS Model Warm-up and Memory Preload Service
After=lazy-llm.service
Requires=lazy-llm.service

[Service]
Type=oneshot
User=lazy-llm
Group=lazy-llm
LimitMEMLOCK=infinity
CPUAffinity=0-1
Nice=-5
ExecStart=/usr/bin/python3 -m lazy.tuning.warmup --socket /run/lazy/llm.sock
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
