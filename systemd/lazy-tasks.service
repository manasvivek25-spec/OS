[Unit]
Description=Lazy OS Task Manager & Snapshot Undo Service
After=lazy-policy.service

[Service]
Type=simple
User=lazy-tasks
Group=lazy-tasks
StateDirectory=lazy/snapshots
WorkingDirectory=/var/lib/lazy
ExecStart=/usr/bin/python3 -m lazy.tasks.service --socket /run/lazy/tasks.sock
Restart=on-failure
RestartSec=2s

# Sandboxing Directives (Rule F5, F7)
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/lazy /data /var/lib/lazy
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
CapabilityBoundingSet=
UMask=0077
RemoveIPC=yes
IPAddressDeny=any
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service ~@privileged ~@resources
SystemCallArchitectures=native

# Resource Isolation
MemoryMax=256M
CPUWeight=100
TasksMax=32

[Install]
WantedBy=multi-user.target
