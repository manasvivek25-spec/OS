[Unit]
Description=Lazy OS Policy Engine & Capability Validator
After=local-fs.target

[Service]
Type=simple
User=lazy-policy
Group=lazy-policy
WorkingDirectory=/var/lib/lazy
ReadOnlyPaths=/etc/lazy/capabilities /etc/lazy/policy.yaml
ExecStart=/usr/bin/python3 -m lazy.policy.service --socket /run/lazy/policy.sock
Restart=on-failure
RestartSec=2s

# Sandboxing Directives (Rule F1, F6)
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/lazy
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
CapabilityBoundingSet=
UMask=0077
RemoveIPC=yes
IPAddressDeny=any
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service ~@privileged ~@resources
SystemCallArchitectures=native

# Resource Isolation
MemoryMax=128M
CPUWeight=150
TasksMax=32

[Install]
WantedBy=multi-user.target
