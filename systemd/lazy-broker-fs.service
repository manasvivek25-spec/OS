[Unit]
Description=Lazy OS Filesystem Broker (lazy-broker-fs)
After=lazy-tasks.service

[Service]
Type=simple
User=lazy-broker-fs
Group=lazy-broker-fs
WorkingDirectory=/var/lib/lazy
ExecStart=/usr/bin/python3 -m lazy.brokers.fs_service --socket /run/lazy/broker-fs.sock
Restart=on-failure
RestartSec=2s

# Sandboxing Directives (Rule F1, F2)
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/lazy /data
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
CapabilityBoundingSet=
UMask=0077
RemoveIPC=yes
IPAddressDeny=any
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# Local path execution only, zero network access
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service ~@privileged ~@resources
SystemCallArchitectures=native

# Resource Isolation
MemoryMax=256M
CPUWeight=100
TasksMax=64

[Install]
WantedBy=multi-user.target
