[Unit]
Description=Lazy OS Sandboxed Web & Feed Fetcher
After=network.target

[Service]
Type=simple
User=lazy-fetch
Group=lazy-fetch
RuntimeDirectory=lazy
RuntimeDirectoryMode=0755
WorkingDirectory=/var/lib/lazy
ExecStart=/usr/bin/python3 -m lazy.niche.fetch_service --socket /run/lazy/fetcher.sock
Restart=on-failure
RestartSec=2s

# Sandboxing Directives (Rule F3: untrusted content isolation)
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service ~@privileged ~@resources
SystemCallArchitectures=native

# Resource Isolation (Background Priority)
MemoryMax=256M
CPUWeight=50
IOWeight=50
Nice=10
CPUAffinity=2-3
TasksMax=32

[Install]
WantedBy=multi-user.target
