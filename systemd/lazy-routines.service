[Unit]
Description=Lazy OS Routines Engine (Briefing & Chores)
After=lazy-tasks.service lazy-policy.service

[Service]
Type=simple
User=lazy-rout
Group=lazy-rout
RuntimeDirectory=lazy
RuntimeDirectoryMode=0755
WorkingDirectory=/var/lib/lazy
ExecStart=/usr/bin/python3 -m lazy.routines.service --socket /run/lazy/routines.sock
Restart=on-failure
RestartSec=2s

# Sandboxing Directives
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service ~@privileged ~@resources
SystemCallArchitectures=native

# Resource Isolation
MemoryMax=256M
CPUWeight=100
TasksMax=32

[Install]
WantedBy=multi-user.target
