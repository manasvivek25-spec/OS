[Unit]
Description=Lazy OS Routines Engine (Briefing & Chores)
After=lazy-tasks.service lazy-policy.service

[Service]
Type=simple
User=lazy-routines
Group=lazy-routines
WorkingDirectory=/var/lib/lazy
ExecStart=/usr/bin/python3 -m lazy.routines.service --socket /run/lazy/routines.sock
Restart=on-failure
RestartSec=2s

# Sandboxing Directives
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/lazy /data
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
CapabilityBoundingSet=
UMask=0077
RemoveIPC=yes
IPAddressDeny=any
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service ~@privileged ~@resources
SystemCallArchitectures=native

# Resource Isolation (Background Priority)
MemoryMax=256M
CPUWeight=50
IOWeight=50
Nice=10
TasksMax=32
CPUAffinity=0-3

[Install]
WantedBy=multi-user.target
