[Unit]
Description=Lazy OS LLM Inference Engine (llama.cpp)
After=local-fs.target

[Service]
Type=simple
User=lazy-llm
Group=lazy-llm
WorkingDirectory=/var/lib/lazy
ExecStart=/usr/bin/python3 -m lazy.llm.service --socket /run/lazy/llm.sock
Restart=on-failure
RestartSec=3s

# Sandboxing Directives
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/lazy
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
CapabilityBoundingSet=
UMask=0077
RemoveIPC=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
# Local IPC and loopback HTTP
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service ~@privileged ~@resources
SystemCallArchitectures=native

# Resource Isolation (Warm resident model with interactive tuning)
Nice=5
MemoryMax=3072M
CPUWeight=200
IOWeight=500
TasksMax=64
LimitMEMLOCK=infinity
CPUAffinity=0-3

[Install]
WantedBy=multi-user.target
