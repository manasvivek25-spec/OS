[Unit]
Description=Lazy OS Hardware Control Broker (lazy-broker-hw)
After=local-fs.target

[Service]
Type=simple
User=lazy-brk-hw
Group=lazy-brk-hw
RuntimeDirectory=lazy
RuntimeDirectoryMode=0755
WorkingDirectory=/var/lib/lazy
ReadWritePaths=/sys/class/backlight /sys/class/rfkill /sys/devices/system/cpu
ExecStart=/usr/bin/python3 -m lazy.brokers.hw_service --socket /run/lazy/broker-hw.sock
Restart=on-failure
RestartSec=2s

# Sandboxing Directives
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service ~@privileged ~@resources
SystemCallArchitectures=native

# Resource Isolation
MemoryMax=128M
CPUWeight=100
TasksMax=32

[Install]
WantedBy=multi-user.target
