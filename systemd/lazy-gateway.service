[Unit]
Description=Lazy OS Gateway Service (I/O, WebSocket, HUD)
After=network.target lazy-policy.service lazy-planner.service
Requires=lazy-policy.service

[Service]
Type=simple
User=lazy-gw
Group=lazy-gw
WorkingDirectory=/var/lib/lazy
ExecStart=/usr/bin/python3 -m lazy.gateway.server --host 0.0.0.0 --port 8765
Restart=on-failure
RestartSec=2s

# Sandboxing Directives (Rule F2, Frozen Architecture)
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/lazy /data /var/log
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
CapabilityBoundingSet=
UMask=0002
RemoveIPC=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service ~@privileged ~@resources
SystemCallArchitectures=native

# Resource Isolation (Interactive Priority)
MemoryMax=256M
CPUWeight=400
IOWeight=400
TasksMax=64

[Install]
WantedBy=multi-user.target
