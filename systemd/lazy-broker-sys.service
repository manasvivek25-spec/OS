[Unit]
Description=Lazy OS System Administration Broker (lazy-broker-sys)
After=local-fs.target

[Service]
Type=simple
User=lazy-broker-sys
Group=lazy-broker-sys
WorkingDirectory=/var/lib/lazy
ExecStart=/usr/bin/python3 -m lazy.brokers.sys_service --socket /run/lazy/broker-sys.sock
Restart=on-failure
RestartSec=2s

# Sandboxing Directives
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/lazy
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
CapabilityBoundingSet=
UMask=0077
RemoveIPC=yes
IPAddressDeny=any
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service ~@privileged ~@resources
SystemCallArchitectures=native

# Resource Isolation
MemoryMax=128M
CPUWeight=100
TasksMax=32

[Install]
WantedBy=multi-user.target
