[Unit]
Description=Lazy OS Secrets Vault (SO_PEERCRED verified)
After=local-fs.target

[Service]
Type=simple
User=lazy-secrets
Group=lazy-secrets
RuntimeDirectory=lazy
RuntimeDirectoryMode=0755
StateDirectory=lazy/secrets
StateDirectoryMode=0700
WorkingDirectory=/var/lib/lazy/secrets
ExecStart=/usr/bin/python3 -m lazy.secrets.server --socket /run/lazy/secrets.sock
Restart=on-failure
RestartSec=2s

# Sandboxing Directives (Rule F4: unreachable by planner)
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service ~@privileged ~@resources
SystemCallArchitectures=native

# Resource Isolation
MemoryMax=64M
CPUWeight=100
TasksMax=16

[Install]
WantedBy=multi-user.target
