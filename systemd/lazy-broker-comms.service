[Unit]
Description=Lazy OS Communications Broker (lazy-broker-comms)
After=network.target

[Service]
Type=simple
User=lazy-broker-comms
Group=lazy-broker-comms
WorkingDirectory=/var/lib/lazy
ExecStart=/usr/bin/python3 -m lazy.brokers.comms_service --socket /run/lazy/broker-comms.sock
Restart=on-failure
RestartSec=2s

# Sandboxing Directives (Rule F8: external sends)
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/lazy /data
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
CapabilityBoundingSet=
UMask=0077
RemoveIPC=yes
IPAddressDeny=any
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service ~@privileged ~@resources
SystemCallArchitectures=native

# Resource Isolation
MemoryMax=256M
CPUWeight=100
TasksMax=32

[Install]
WantedBy=multi-user.target
